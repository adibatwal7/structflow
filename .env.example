# ==============================================================================
# Structflow Configuration (.env.example)
#
# Copy this file to .env and adjust the values as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# vLLM Server & Model Settings
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Generation Parameters (Number Rules)
# temperature: at least 0.0 (ge=0.0), at most 2.0 (le=2.0)
TEMPERATURE=0.7

# top_p: strictly greater than 0.0 (gt=0.0), at most 1.0 (le=1.0)
TOP_P=1.0

# max_tokens: strictly greater than 0 (gt=0), at most 32768 (le=32768)
MAX_TOKENS=2048

# Operational & Network Settings
# timeout: strictly greater than 0.0 (gt=0.0) seconds
TIMEOUT=60.0

# max_retries: at least 0 (ge=0), at most 10 (le=10)
MAX_RETRIES=3
