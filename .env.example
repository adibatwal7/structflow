# ==============================================================================
# Structflow Configuration (.env.example)
#
# Copy this file to .env and adjust the values as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# vLLM Server & Model Settings
STRUCTFLOW_VLLM_BASE_URL=http://localhost:8000/v1
STRUCTFLOW_VLLM_API_KEY=EMPTY
STRUCTFLOW_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Phase 2 Operational & Batching Settings
# request_timeout_s: HTTP request timeout in seconds (gt=0.0)
STRUCTFLOW_REQUEST_TIMEOUT_S=60.0

# max_inflight_generation: maximum concurrent generation requests in flight (gt=0)
STRUCTFLOW_MAX_INFLIGHT_GENERATION=64

# microbatch_max_size: maximum microbatch size (gt=0)
STRUCTFLOW_MICROBATCH_MAX_SIZE=8

# microbatch_max_wait_ms: maximum wait time in milliseconds before dispatching (ge=0, le=100)
STRUCTFLOW_MICROBATCH_MAX_WAIT_MS=5

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
STRUCTFLOW_LOG_LEVEL=INFO

# Softmax head: "fake" (no model) or "hf" (real Hugging Face model)
STRUCTFLOW_CLASSIFIER_BACKEND=fake
STRUCTFLOW_CLASSIFIER_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
STRUCTFLOW_CLASSIFIER_DEVICE=auto
STRUCTFLOW_CLASSIFIER_MAX_LENGTH=512
STRUCTFLOW_MICROBATCH_MAX_QUEUE=256

# Span head: "fake" (no model) or "hf" (real NER model)
STRUCTFLOW_SPAN_BACKEND=fake
STRUCTFLOW_SPAN_MODEL=dslim/distilbert-NER
STRUCTFLOW_SPAN_DEVICE=auto
STRUCTFLOW_SPAN_MAX_LENGTH=512
